(namespace library-check
  (export same)
  (use ::ncg2lib::bool::not invert)

  ; 両方が偽か両方が真であれば入力は等しい。
  (defn same
    (as-type (Fn (Bool Bool) Bool)
      (fn (left right)
        (::ncg2lib::bool::xor
          (invert (::ncg2lib::bool::or left right))
          (::ncg2lib::bool::and left right))))))
